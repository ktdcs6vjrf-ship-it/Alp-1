vwStart  = input.time(timestamp("26 Jan 2023 00:00:00 UTC+0"), "Start Date AVWAP",
     group = gV, tooltip = "Lu seulement en mode AVWAP : le VWAP part de cette date et ne se remet plus à zéro.")
vwPlotSd = input.bool(true, "Plot Standard Deviation", group = gV, inline = "sd")
vwFill   = input.bool(true, "Fill Bands", group = gV, inline = "sd")

gS = "STANDARD DEVIATION SELECTION"
on1 = input.bool(true, "", group = gS, inline = "m1")
k1  = input.float(1.0, "StDev mult 1", minval = 0.0, step = 0.5, group = gS, inline = "m1")
on2 = input.bool(true, "", group = gS, inline = "m2")
k2  = input.float(2.0, "StDev mult 2", minval = 0.0, step = 0.5, group = gS, inline = "m2")
on3 = input.bool(true, "", group = gS, inline = "m3")
k3  = input.float(3.0, "StDev mult 3", minval = 0.0, step = 0.5, group = gS, inline = "m3")
on4 = input.bool(true, "", group = gS, inline = "m4")
k4  = input.float(0.5, "StDev mult 4", minval = 0.0, step = 0.5, group = gS, inline = "m4")
on5 = input.bool(true, "", group = gS, inline = "m5")
k5  = input.float(1.5, "StDev mult 5", minval = 0.0, step = 0.5, group = gS, inline = "m5")
on6 = input.bool(true, "", group = gS, inline = "m6")
k6  = input.float(2.5, "StDev mult 6", minval = 0.0, step = 0.5, group = gS, inline = "m6")

gP = "PREVIOUS PERIOD VWAP"
pv1    = input.bool(true, "Plot PVWAP 1+- Levels", group = gP)
pv2    = input.bool(true, "Plot PVWAP 2+- Levels", group = gP)
pvFill = input.bool(true, "Fill Previous Bands", group = gP)

gL = "LABELS"
vwLab    = input.bool(true, "Show Labels", group = gL, inline = "lb")
vwPLab   = input.bool(false, "Show Previous Labels", group = gL, inline = "lb")
