//@version=6
indicator("Alp-0 Zones", "Alp-0 Zones", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ═══════════════════════════════════════════════════════════════════════════
//  Alp-0 Zones — z-score · VWAP σ · zones gamma, IV et profil de volume
//
//  ÉTAPE 1 du cahier des charges (docs/zones-gamma-format.md) :
//    ①–③ la heatmap z-score des bougies — l'ancien « Z + Single Prints
//       (OPEX) », corrigé (voir la section A) ;
//    ④ VWAP et six bandes σ, VWAP de la période précédente : les réglages de
//       « The Strategists - Aggregated VWAP » tels qu'ils sont saisis sur le
//       graphique (agrégation désactivée — sans objet sur un future CME) ;
//    ⑤ import texte des relevés Gexbot que Lou colle, format ALPZ 1 ;
//    ⑥–⑦ horaires, niveaux en gris pointillé, étiquettes à droite, filtres ;
//    ⑧ CONFLUENCES : les niveaux proches forment une seule zone, sans
//       qu'aucun prix soit déplacé ;
//    ⑨ touches et réactions, jugées sur bougies confirmées seulement ;
//    ⑩ profil GEX signé 0DTE, à droite du prix, s'il est fourni par strike ;
//    ⑪ tableau et alertes.
//
//  Ce que le script ne fait pas — et ne peut pas faire
//  ---------------------------------------------------
//  · Pine n'a aucun accès réseau : il ne lit pas Discord, ne lance aucune
//    commande, n'interroge aucune API. Le collage de Lou est la seule entrée.
//  · Il ne fabrique aucune valeur : une donnée absente reste absente, une
//    donnée invalide est refusée et signalée au tableau.
//  · Il ne passe aucun ordre et n'affiche aucune probabilité ni aucun score
//    de confiance. Une confluence est une hypothèse de travail, pas une
//    preuve.
//  · Il ne s'exécute qu'aux mises à jour du graphique. Le gel de 22 h est
//    POSÉ à 22 h (la fin du segment est l'horodatage exact), mais il n'est
//    APPLIQUÉ qu'à la première bougie qui suit : sans bougie, rien ne bouge.
//  · Il n'a pas de mémoire propre : le texte collé EST l'archive. Le
//    modifier réécrit l'historique ; le script ne peut pas le détecter.
//
//  Vocabulaire. On parle de CONFLUENCE, jamais de co-intégration : la
//  proximité de deux niveaux n'est pas un test économétrique.
// ═══════════════════════════════════════════════════════════════════════════

JOUR_MS  = 86400000
HEURE_MS = 3600000
MIN_MS   = 60000
MAX_MSG  = 80
MAX_OBS  = 5000
MAX_EPQ  = 3000
// Affichée en tête du tableau : la première chose à vérifier quand le
// graphique ne montre pas ce qu'on attend est la version qui tourne.
VERSION  = "v3"


// ─── ①–③ Z-score (heatmap des bougies) ────────────────────────────────────
gZ = "① Z-Score"
zOn  = input.bool(true, "Colorer les bougies (heatmap)", group = gZ)
zSrc = input.source(ohlc4, "Source", group = gZ, display = display.none)
zLen = input.int(50, "Lookback", minval = 2, group = gZ, display = display.none)
zT1  = input.float(2.0, "Threshold T1 (σ)", minval = 0.1, step = 0.1, group = gZ, inline = "t", display = display.none)
zT2  = input.float(3.0, "Threshold T2 (σ)", minval = 0.1, step = 0.1, group = gZ, inline = "t", display = display.none,
     tooltip = "Sous T1 : neutre. De T1 à T2 : dégradé. Au-delà de T2 : couleur pleine. La valeur absolue du z-score est lue : un excès au-dessus et un excès au-dessous de la moyenne prennent la même couleur.")

gZC = "② Z-Score Colors"
zcT1  = input.color(color.rgb(45, 171, 173), "Cyan (T1 extreme)", group = gZC)
zcT2  = input.color(color.rgb(229, 5, 255), "Magenta (T2 extreme)", group = gZC)
zcNeu = input.color(color.rgb(51, 51, 51), "Neutral (within thresholds)", group = gZC)

gZB = "③ Z-Score Brightness"
zCustom  = input.bool(false, "Custom Wick/Border", group = gZB)
zBordPct = input.int(-20, "Border %", minval = -100, maxval = 100, group = gZB, inline = "b", display = display.none)
zWickPct = input.int(10, "Wick %", minval = -100, maxval = 100, group = gZB, inline = "b", display = display.none)


// ─── ④ VWAP — réglages repris de « The Strategists » ───────────────────────
gV = "④ VWAP SELECTION"
vwAnc    = input.string("Day", "VWAP and SDev:", group = gV,
     options = ["Day", "Week", "Month", "Quarter", "Year", "AVWAP"])
