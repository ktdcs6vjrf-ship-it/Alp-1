//@version=6
indicator("Alp-0", "Alp-0", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════════════════
//  Alp-0
//
//  Trois objets, et un seul qui compte :
//    1. VWAP ancre, avec ses bandes d'ecart-type ponderees par le volume.
//    2. Les zones d'accumulation qui ont produit une reaction mesurable.
//    3. Le moment ou une bande sigma tombe SUR une de ces zones.
//
//  Le troisieme est la raison d'etre de l'indicateur. Les deux premiers ne
//  sont la que pour le rendre calculable.
// ═══════════════════════════════════════════════════════════════════════════


// ─── ① Ancrage ────────────────────────────────────────────────────────────
gA = "① Ancrage"
anchorSel = input.string("Session", "Remise a zero", options = ["Session", "Semaine", "Mois"],
     group = gA, tooltip = "Le VWAP et son ecart-type repartent de zero a chaque nouvelle periode.")
src = input.source(hlc3, "Source du prix", group = gA)

// ─── ② Bandes σ ───────────────────────────────────────────────────────────
gB = "② Bandes σ"
showBands = input.bool(true, "Afficher les bandes", group = gB)
mA = input.float(0.5, "Multiplicateurs", minval = 0.1, maxval = 10, step = 0.1, group = gB, inline = "r1")
mB = input.float(1.0, "",                minval = 0.1, maxval = 10, step = 0.1, group = gB, inline = "r1")
mC = input.float(1.5, "",                minval = 0.1, maxval = 10, step = 0.1, group = gB, inline = "r1")
mD = input.float(2.0, "",                minval = 0.1, maxval = 10, step = 0.1, group = gB, inline = "r2")
mE = input.float(2.5, "",                minval = 0.1, maxval = 10, step = 0.1, group = gB, inline = "r2")
mF = input.float(3.0, "",                minval = 0.1, maxval = 10, step = 0.1, group = gB, inline = "r2")

// ─── ③ Apparence ──────────────────────────────────────────────────────────
gC = "③ Apparence"
colVwap = input.color(#FFFFFF, "VWAP",                          group = gC)
colFull = input.color(#E4E4E4, "Bandes pleines (1 · 2 · 3)",    group = gC)
colHalf = input.color(#7A7A7A, "Bandes demi (.5 · 1.5 · 2.5)",  group = gC)
colFill = input.color(#202020, "Remplissage",                   group = gC)
opCore  = input.int(34, "Opacite du coeur (0 → 1σ)   %", minval = 0, maxval = 100, group = gC)
opEdge  = input.int(7,  "Opacite du bord   (→ 3σ)    %", minval = 0, maxval = 100, group = gC)

// ─── ④ Zones d'accumulation ───────────────────────────────────────────────
gZ = "④ Zones d'accumulation"
showZones = input.bool(true, "Afficher les zones", group = gZ)
pivLen   = input.int(10,    "Portee du pivot (barres)", minval = 2, maxval = 100, group = gZ,
     tooltip = "Nombre de barres de chaque cote qui definissent un sommet ou un creux.")
volMult  = input.float(1.5, "Volume ≥ n × la moyenne", minval = 1.0, maxval = 10, step = 0.1, group = gZ,
     tooltip = "L'accumulation : il faut qu'il se soit echange nettement plus que d'habitude.")
reactATR = input.float(1.5, "Reaction ≥ n × ATR", minval = 0.2, maxval = 20, step = 0.1, group = gZ,
     tooltip = "La reaction : le prix doit s'etre ecarte franchement de la zone ensuite.")
zoneATR  = input.float(0.30, "Epaisseur de zone (× ATR)", minval = 0.05, maxval = 5, step = 0.05, group = gZ)
maxZones = input.int(8, "Zones conservees", minval = 1, maxval = 40, group = gZ)

// ─── ⑤ Confluence ─────────────────────────────────────────────────────────
gF = "⑤ Confluence"
showConf  = input.bool(true, "Signaler la confluence", group = gF)
tolATR    = input.float(0.25, "Tolerance (× ATR)", minval = 0.01, maxval = 5, step = 0.05, group = gF,
     tooltip = "Distance en dessous de laquelle une bande et une zone sont dits au meme niveau.")
colConf   = input.color(#FFFFFF, "Couleur du signal", group = gF)
showTable = input.bool(true, "Tableau de lecture", group = gF)


// ═══════════════════════════════════════════════════════════════════════════
//  1. VWAP et ecart-type ponderes par le volume
//     Var(P) = Σ(v·P²)/Σv − (Σ(v·P)/Σv)²  — la forme exacte, pas une SMA.
// ═══════════════════════════════════════════════════════════════════════════

anchorTF  = anchorSel == "Session" ? "D" : anchorSel == "Semaine" ? "W" : "M"
newAnchor = timeframe.change(anchorTF)

// Un instrument sans volume publie retombe sur une moyenne non ponderee :
// l'indicateur reste lisible au lieu de disparaitre.
vol = na(volume) or volume <= 0 ? 1.0 : volume

var float cumPV  = 0.0
var float cumV   = 0.0
var float cumP2V = 0.0

if newAnchor or bar_index == 0
    cumPV  := 0.0
    cumV   := 0.0
    cumP2V := 0.0

cumPV  += src * vol
cumV   += vol
cumP2V += src * src * vol

vwapVal = cumV > 0 ? cumPV / cumV : src
varPond = cumV > 0 ? math.max(cumP2V / cumV - vwapVal * vwapVal, 0.0) : 0.0
sd      = math.sqrt(varPond)

uA = vwapVal + mA * sd
uB = vwapVal + mB * sd
uC = vwapVal + mC * sd
uD = vwapVal + mD * sd
uE = vwapVal + mE * sd
uF = vwapVal + mF * sd
dA = vwapVal - mA * sd
dB = vwapVal - mB * sd
dC = vwapVal - mC * sd
dD = vwapVal - mD * sd
dE = vwapVal - mE * sd
dF = vwapVal - mF * sd


// ═══════════════════════════════════════════════════════════════════════════
//  2. Bandes et remplissages
//     L'opacite decroit du centre vers le bord : le coeur 0 → 1σ est dense,
//     le reste s'efface. C'est ce qui donne le rendu du modele.
// ═══════════════════════════════════════════════════════════════════════════

// transparence Pine : 0 = opaque, 100 = invisible
transpAt(int i) =>
    o = opCore + (opEdge - opCore) * (i - 1) / 5.0
    math.max(0.0, math.min(100.0, 100.0 - o))

pV  = plot(showBands ? vwapVal : na, "VWAP",  color = colVwap, linewidth = 2)
pUA = plot(showBands ? uA : na, "+0.5σ", color = colHalf, linewidth = 1)
pUB = plot(showBands ? uB : na, "+1σ",   color = colFull, linewidth = 1)
pUC = plot(showBands ? uC : na, "+1.5σ", color = colHalf, linewidth = 1)
pUD = plot(showBands ? uD : na, "+2σ",   color = colFull, linewidth = 1)
pUE = plot(showBands ? uE : na, "+2.5σ", color = colHalf, linewidth = 1)
pUF = plot(showBands ? uF : na, "+3σ",   color = colFull, linewidth = 1)
pDA = plot(showBands ? dA : na, "−0.5σ", color = colHalf, linewidth = 1)
pDB = plot(showBands ? dB : na, "−1σ",   color = colFull, linewidth = 1)
pDC = plot(showBands ? dC : na, "−1.5σ", color = colHalf, linewidth = 1)
pDD = plot(showBands ? dD : na, "−2σ",   color = colFull, linewidth = 1)
pDE = plot(showBands ? dE : na, "−2.5σ", color = colHalf, linewidth = 1)
pDF = plot(showBands ? dF : na, "−3σ",   color = colFull, linewidth = 1)

fill(pV,  pUA, color.new(colFill, transpAt(1)), "0 → +0.5σ")
fill(pUA, pUB, color.new(colFill, transpAt(2)), "+0.5 → +1σ")
fill(pUB, pUC, color.new(colFill, transpAt(3)), "+1 → +1.5σ")
fill(pUC, pUD, color.new(colFill, transpAt(4)), "+1.5 → +2σ")
fill(pUD, pUE, color.new(colFill, transpAt(5)), "+2 → +2.5σ")
fill(pUE, pUF, color.new(colFill, transpAt(6)), "+2.5 → +3σ")
fill(pV,  pDA, color.new(colFill, transpAt(1)), "0 → −0.5σ")
fill(pDA, pDB, color.new(colFill, transpAt(2)), "−0.5 → −1σ")
fill(pDB, pDC, color.new(colFill, transpAt(3)), "−1 → −1.5σ")
fill(pDC, pDD, color.new(colFill, transpAt(4)), "−1.5 → −2σ")
fill(pDD, pDE, color.new(colFill, transpAt(5)), "−2 → −2.5σ")
fill(pDE, pDF, color.new(colFill, transpAt(6)), "−2.5 → −3σ")


// ═══════════════════════════════════════════════════════════════════════════
//  3. Zones d'accumulation
//
//  Une zone n'est retenue que si les DEUX conditions tiennent :
//    accumulation — il s'est echange nettement plus que d'habitude autour du
//                   pivot, donc du volume s'y est reellement pose ;
//    reaction     — le prix s'en est ecarte d'au moins n ATR ensuite.
//
//  Un pivot sans volume est un accident de trace. Du volume sans reaction est
//  une simple zone de negociation. Il faut les deux pour parler de support.
// ═══════════════════════════════════════════════════════════════════════════

atrVal = ta.atr(14)
volRef = ta.sma(vol, 100)
volWin = ta.sma(vol, pivLen * 2 + 1)

ph     = ta.pivothigh(high, pivLen, pivLen)
pl     = ta.pivotlow(low,  pivLen, pivLen)
lowN   = ta.lowest(low,   pivLen)
highN  = ta.highest(high, pivLen)

reactDown = na(ph) ? 0.0 : ph - lowN
reactUp   = na(pl) ? 0.0 : highN - pl

accum   = not na(volRef) and volRef > 0 and volWin >= volMult * volRef
minMove = reactATR * atrVal

newRes = not na(ph) and accum and reactDown >= minMove
newSup = not na(pl) and accum and reactUp   >= minMove

var array<float> zMid = array.new<float>()
var array<bool>  zSup = array.new<bool>()
var array<float> zPow = array.new<float>()
var array<box>   zBox = array.new<box>()

pushZone(float mid, bool isSup, float power) =>
    half = zoneATR * atrVal / 2.0
    array.push(zMid, mid)
    array.push(zSup, isSup)
    array.push(zPow, power)
    b = box.new(bar_index - pivLen * 2, mid + half, bar_index, mid - half,
         border_color = showZones ? color.new(colHalf, 55) : color.new(colHalf, 100),
         border_width = 1,
         bgcolor      = showZones ? color.new(colFill, 62) : color.new(colFill, 100),
         extend       = extend.right)
    array.push(zBox, b)
    if array.size(zMid) > maxZones
        box.delete(array.shift(zBox))
        array.shift(zMid)
        array.shift(zSup)
        array.shift(zPow)

if barstate.isconfirmed and not na(atrVal) and atrVal > 0
    if newRes
        pushZone(ph, false, volWin / volRef * (reactDown / atrVal))
    if newSup
        pushZone(pl, true,  volWin / volRef * (reactUp   / atrVal))


// ═══════════════════════════════════════════════════════════════════════════
//  4. Confluence — une bande σ tombe sur une zone
//
//  C'est le seul evenement que l'indicateur pretend signaler. Il ne dit pas
//  d'acheter : il dit que deux reperes construits par des mecaniques
//  independantes — le volume ecoule depuis l'ancrage, et le volume pose a un
//  niveau — designent le meme prix.
// ═══════════════════════════════════════════════════════════════════════════

var array<float>  lvlVal = array.new<float>(13, 0.0)
var array<string> lvlNam = array.new<string>(13, "")

if barstate.isfirst
    array.set(lvlNam, 0,  "VWAP")
    array.set(lvlNam, 1,  "+" + str.tostring(mA, "#.##") + "σ")
    array.set(lvlNam, 2,  "+" + str.tostring(mB, "#.##") + "σ")
    array.set(lvlNam, 3,  "+" + str.tostring(mC, "#.##") + "σ")
    array.set(lvlNam, 4,  "+" + str.tostring(mD, "#.##") + "σ")
    array.set(lvlNam, 5,  "+" + str.tostring(mE, "#.##") + "σ")
    array.set(lvlNam, 6,  "+" + str.tostring(mF, "#.##") + "σ")
    array.set(lvlNam, 7,  "−" + str.tostring(mA, "#.##") + "σ")
    array.set(lvlNam, 8,  "−" + str.tostring(mB, "#.##") + "σ")
    array.set(lvlNam, 9,  "−" + str.tostring(mC, "#.##") + "σ")
    array.set(lvlNam, 10, "−" + str.tostring(mD, "#.##") + "σ")
    array.set(lvlNam, 11, "−" + str.tostring(mE, "#.##") + "σ")
    array.set(lvlNam, 12, "−" + str.tostring(mF, "#.##") + "σ")

array.set(lvlVal, 0,  vwapVal)
array.set(lvlVal, 1,  uA)
array.set(lvlVal, 2,  uB)
array.set(lvlVal, 3,  uC)
array.set(lvlVal, 4,  uD)
array.set(lvlVal, 5,  uE)
array.set(lvlVal, 6,  uF)
array.set(lvlVal, 7,  dA)
array.set(lvlVal, 8,  dB)
array.set(lvlVal, 9,  dC)
array.set(lvlVal, 10, dD)
array.set(lvlVal, 11, dE)
array.set(lvlVal, 12, dF)

var array<line>  cLine = array.new<line>()
var array<label> cLab  = array.new<label>()

tol = tolATR * atrVal

bool   confNow   = false
float  confPrice = na
string confName  = ""
bool   confIsSup = true
float  confPow   = -1.0

if showConf and sd > 0 and not na(tol) and array.size(zMid) > 0
    for zi = 0 to array.size(zMid) - 1
        zc = array.get(zMid, zi)
        for li = 0 to 12
            lv = array.get(lvlVal, li)
            if not na(lv) and math.abs(lv - zc) <= tol
                pw = array.get(zPow, zi)
                if pw > confPow
                    confNow   := true
                    confPrice := (lv + zc) / 2.0
                    confName  := array.get(lvlNam, li)
                    confIsSup := array.get(zSup, zi)
                    confPow   := pw

var float lastConf = na
confFresh = confNow and (na(lastConf) or math.abs(confPrice - lastConf) > tol)
confDraw  = confFresh and barstate.isconfirmed

if confDraw
    lastConf := confPrice
    ln = line.new(math.max(bar_index - 2, 0), confPrice, bar_index + 12, confPrice,
         color = colConf, width = 2, style = line.style_solid)
    lb = label.new(bar_index + 12, confPrice,
         confName + "  ·  " + (confIsSup ? "support" : "resistance"),
         style = label.style_label_left, textcolor = colConf,
         color = color.new(colFill, 20), size = size.small)
    array.push(cLine, ln)
    array.push(cLab,  lb)
    if array.size(cLine) > 20
        line.delete(array.shift(cLine))
        label.delete(array.shift(cLab))

if not confNow
    lastConf := na

plotshape(confDraw ? confPrice : na, "Confluence", shape.diamond,
     location.absolute, color.new(colConf, 0), size = size.tiny)

bgcolor(confNow ? color.new(colConf, 95) : na, title = "Fond de confluence")

alertcondition(confFresh, "Alp-0 · confluence",
     "Alp-0 : une bande sigma tombe sur une zone d'accumulation.")


// ═══════════════════════════════════════════════════════════════════════════
//  5. Tableau de lecture
// ═══════════════════════════════════════════════════════════════════════════

var table tb = table.new(position.top_right, 2, 4,
     bgcolor = color.new(#202020, 12), border_color = color.new(#7A7A7A, 60), border_width = 1)

if showTable and barstate.islast
    sigPos = sd > 0 ? (close - vwapVal) / sd : 0.0
    signe  = sigPos >= 0 ? "+" : "−"
    table.cell(tb, 0, 0, "Alp-0",         text_color = colHalf, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, anchorSel,       text_color = colVwap, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "Position",      text_color = colHalf, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, signe + str.tostring(math.abs(sigPos), "0.00") + " σ",
         text_color = colVwap, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Zones actives", text_color = colHalf, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, str.tostring(array.size(zMid)),
         text_color = colVwap, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Confluence",    text_color = colHalf, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, confNow ? confName + " · " + (confIsSup ? "sup" : "res") : "—",
         text_color = confNow ? colConf : colHalf, text_size = size.small, text_halign = text.align_right)
